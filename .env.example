# ---------------------------------------------------------------------------
# Family Tree 本地配置示例（一键 Docker 启动通常不需要复制此文件）
# 默认端口约定（GSB0825 → 25）: 前端 3025 / 后端 8025 / 数据库 5025
# 若需覆盖 docker-compose.yml 中的值，可复制为 .env 后修改。
# ---------------------------------------------------------------------------

UI_PORT=3025
BACKEND_PORT=8025
DB_PORT=5025

APP_DATA_PATH=./appdata
DATA_PATH=./data

ENVIRONMENT=production
SECRET_KEY=family-tree-local-secret-key-please-change-in-prod

FRONTEND_URL=http://localhost:3025
CORS_ORIGINS=http://localhost:3025

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=familytree
POSTGRES_PASSWORD=familytree
POSTGRES_DB=familytree

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin12345678
FIRST_ADMIN_EMAIL=admin@example.com
ALLOW_SELF_REGISTRATION=false
